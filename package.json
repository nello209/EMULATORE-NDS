{
  "name": "vesuvio",
  "version": "1.0.0",
  "private": true,
  "description": "Emulatore Nintendo DS / GBA / Game Boy per il browser (PWA), con salvataggi sicuri.",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "serve": "node tools/serve.mjs 8080",
    "test": "node --test \"tests/unit/**/*.test.mjs\"",
    "test:e2e": "node --test --test-concurrency=1 --test-timeout=900000 \"tests/e2e/**/*.test.mjs\"",
    "test:soak": "node tests/soak/soak.mjs",
    "rom": "python3 tools/make_test_rom.py",
    "icons": "node tools/make_icons.mjs"
  },
  "devDependencies": {
    "playwright": "1.64.1"
  }
}
